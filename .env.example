# --- Angel One SmartAPI (required) ---
# Create a Trading API app at smartapi.angelone.in.
# ANGEL_TOTP_SECRET is the text string beside the 2FA QR code, not the 6-digit code.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Optional: Telegram notifications ---
# TELEGRAM_CHAT_ID accepts several recipients, comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: mirror the trade journal into Google Sheets ---
# Paste the whole service account JSON on one line, or give a path to the file.
GOOGLE_SERVICE_ACCOUNT_JSON=
